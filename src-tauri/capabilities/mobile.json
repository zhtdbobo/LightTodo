{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Permissions available to the Android and iOS application",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "core:event:allow-emit",
    "core:event:allow-listen",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/zhtdbobo/LightTodo"
        }
      ]
    }
  ]
}
