{
  "$schema": "https://schema.tauri.app/capabilities/v1",
  "identifier": "default",
  "description": "Default permissions for the application",
  "windows": ["main", "settings"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-is-always-on-top",
    "core:window:allow-set-always-on-top",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "core:window:allow-create",
    "core:window:allow-get-all-windows",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-get-all-webviews",
    "core:event:allow-emit",
    "core:event:allow-listen",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/zhtdbobo/LightTodo"
        },
        {
          "url": "https://gh-proxy.com/github.com/zhtdbobo/LightTodo/releases/download/v*/LightTodo_*_x64-setup.exe"
        }
      ]
    }
  ]
}
